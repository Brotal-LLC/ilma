build/
dist/
*.egg-info/
.eggs/

# Local secrets/config
.env
.env.*
!.env.example

# Editor/OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Test/runtime artifacts
.cache/
logs/
*.log

# Compose-managed local data (if a bind mount is ever used instead of named volumes)
docker/**/data/
docker/**/.data/
