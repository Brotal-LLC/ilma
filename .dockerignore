# VCS
.git
.gitignore
.gitattributes

# Python bytecode/caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and local tooling
.venv/
venv/
env/
.tox/
.nox/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Local secrets/config
.env
.env.*
!.env.example

# Editor/OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Test/runtime artifacts
.cache/
logs/
*.log

# Local Postgres data volumes if anyone bind-mounts into a pg/ container
pg/**/data/
pg/**/.data/

# Local Ollama model caches if anyone bind-mounts into an ollama/ container
ollama/**/data/
ollama/**/.ollama/
